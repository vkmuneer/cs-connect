# Copy to .env and fill in. .env is git-ignored.

# Required: sessions and CSRF tokens depend on this.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional: defaults to SQLite in instance/cs_connect.sqlite
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/cs_connect

# Bootstrap administrator, used by `flask seed`.
ADMIN_EMAIL=admin@sscollege.ac.in
ADMIN_PASSWORD=change-me-too

# 1 = new registrations wait for admin verification, 0 = let them straight in.
REQUIRE_ADMIN_APPROVAL=1

# development | production | testing
FLASK_CONFIG=development
